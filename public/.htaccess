# Hostinger (LiteSpeed/Apache): URLs limpas, página 404 e cabeçalhos.
# Equivale ao public/_headers (Cloudflare Pages) e ao nginx.conf (EasyPanel).
# O redirecionamento para HTTPS fica com a opção "Forçar HTTPS" do hPanel: a CDN
# da Hostinger termina o TLS, então checar %{HTTPS} aqui pode gerar loop.

Options -MultiViews -Indexes
# Sem isso, /portfolio (que também é pasta) viraria /portfolio/ antes das regras.
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.albanoluz.com → albanoluz.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Barra no fim: /sobre/ → /sobre
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1 [R=301,L]

  # Painel: /admin e qualquer subcaminho abrem o admin.html
  RewriteRule ^admin(/.*)?$ /admin.html [L]

  # URLs limpas: /sobre → sobre.html, /servicos/estrutural → servicos/estrutural.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Arquivos do build com hash no nome nunca mudam: cache de 1 ano.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Páginas sempre revalidadas, para uma publicação nova aparecer na hora.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "^admin\.html$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
