# Copie para .env e preencha. Variáveis VITE_* entram no build (são públicas).

# Supabase (Project Settings → API). Sem elas, o site usa as obras ilustrativas
# e o formulário só funciona em modo de desenvolvimento (envio simulado).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (anti-spam do formulário). A chave secreta vai na Edge Function.
VITE_TURNSTILE_SITE_KEY=

# Analítica (carregada só após o aceite de cookies)
VITE_GA4_ID=
VITE_META_PIXEL_ID=
